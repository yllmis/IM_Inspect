  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.43",
    "ai": "^7.0.91",
    "mysql2": "^3.24.4",
    "next": "^15.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.4"
  }
