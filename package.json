{
  "name": "im-inspect",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate-mysql.mjs",
    "start": "next start",
    "format": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
