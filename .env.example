# Public browser configuration belongs here only when it is safe to expose.
# IM credentials and service tokens must stay server-side and out of the repository.
NEXT_PUBLIC_APP_NAME=IM Inspect

# MiMo uses an OpenAI-compatible protocol and a custom api-key header.
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro
MIMO_API_KEY=

# Eval Judge 仅评价客服回复与可观察轨迹，不参与业务诊断事实。
EVAL_JUDGE_MIN_AVERAGE=4
EVAL_JUDGE_PROMPT_VERSION=judge-v1

# Server-side MySQL connection. Do not expose this as NEXT_PUBLIC_*.
MYSQL_DATABASE_URL=mysql://im_inspect:change_me@127.0.0.1:3306/im_inspect
MYSQL_POOL_LIMIT=10

# Optional: enables MySQL integration tests against an isolated test database.
MYSQL_TEST_URL=

# MVP 服务端认证令牌。生产环境应替换为公司的登录/JWT 认证系统。
DEMO_SUPPORT_API_TOKEN=
