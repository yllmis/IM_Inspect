# Public browser configuration belongs here only when it is safe to expose.
# IM credentials and service tokens must stay server-side and out of the repository.
NEXT_PUBLIC_APP_NAME=IM Inspect

# MiMo uses an OpenAI-compatible protocol and a custom api-key header.
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro
MIMO_API_KEY=

# Eval Judge 仅评价客服回复与可观察轨迹，不参与业务诊断事实。
EVAL_JUDGE_MIN_AVERAGE=4
EVAL_JUDGE_PROMPT_VERSION=judge-v1

# Server-side MySQL connection. Do not expose this as NEXT_PUBLIC_*.
MYSQL_DATABASE_URL=mysql://im_inspect:change_me@127.0.0.1:3306/im_inspect
MYSQL_POOL_LIMIT=10

# Optional: enables MySQL integration tests against an isolated test database.
MYSQL_TEST_URL=

# MVP 服务端认证令牌。生产环境应替换为公司的登录/JWT 认证系统。
DEMO_SUPPORT_API_TOKEN=
# Local UI demo only. Ignored in production; production always requires authentication.
DEMO_SUPPORT_AUTO_AUTH=false

# Connector switch. fake is deterministic and does not query a real IM.
IM_INSPECT_CONNECTOR=fake
FAKE_CONNECTOR_FIXTURE=delivered

# 正式接入使用三个领域契约；地址可以相同（由受控 TLS 网关按方法路由）。
GO_IM_QUERY_CONTRACT=domain
GO_IM_MESSAGE_GRPC_URL=
GO_IM_USER_GRPC_URL=
GO_IM_OBSERVATION_GRPC_URL=
GO_IM_MESSAGE_SERVICE_TOKEN=
GO_IM_USER_SERVICE_TOKEN=
GO_IM_OBSERVATION_SERVICE_TOKEN=
GO_IM_TLS_CA_PATH=
# 推荐 TLS。自用远程明文需同时显式开启以下两个开关，服务令牌仍会校验。
GO_IM_INSECURE=false
GO_IM_ALLOW_INSECURE_REMOTE=false
# Connector 能力声明刷新间隔；隧道或服务短暂不可用后会自动重新探测。
GO_IM_CAPABILITY_REFRESH_MS=15000
# Optional IDs for the real Go IM integration suite; keep them out of git.
GO_IM_TEST_MESSAGE_ID=
GO_IM_TEST_MISSING_MESSAGE_ID=
GO_IM_TEST_USER_ID=
GO_IM_TEST_FIXTURE_SET=
# 可选观测故障实例地址，只用于确定性故障测试，不参与正式 Agent 路由。
GO_IM_FAULT_GRPC_URL=
